# Paths that are allowed to differ between main and win32-compat.
#
# Everything else must be byte-identical: win32-compat = main + these paths.
# Adding a Windows file means adding a line here, which is the point -- the
# diff shows up in review.

deploy/win32/README.md
deploy/win32/nginx-flv.conf
deploy/win32/push_test.bat
deploy/win32/start.bat
deploy/win32/stop.bat
docs/archive/win64-linux-crossbuild-notes.md
scripts/package-win64.sh
scripts/win64-windres-wrapper.sh
